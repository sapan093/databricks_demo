{
  "custom_summary": "Datarbicks Alerts Demo",
  "evaluation": {
    "source": {
      "name": "Salary",
      "display": "Salary",
      "aggregation": "AGGREGATION_UNSPECIFIED"
    },
    "comparison_operator": "GREATER_THAN",
    "threshold": {
      "value": {
        "double_value": 100.0
      }
    },
    "notification": {
      "retrigger_seconds": 1,
      "notify_on_ok": true
    }
  },
  "schedule": {
    "quartz_cron_schedule": "17 * * * * ?",
    "timezone_id": "Asia/Calcutta"
  },
  "query_lines": [
    "Declare @SALARY float",
    "set @salary =0",
    "select @salary = salary from employee",
    "",
    "if (@salary > 100)",
    "then",
    "print 'Salary is greater than 100'",
    "else",
    "print 'Salary is less than 100'"
  ],
  "custom_description_lines": [
    "Hi,",
    "These alerts are generated from Databricks Free edition env "
  ]
}
